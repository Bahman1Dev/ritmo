<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="#0F172A"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/alarm_clock_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:textColor="#F8FAFC"
        android:textSize="56sp"
        android:textStyle="bold"
        android:text="00:00" />

    <TextView
        android:id="@+id/alarm_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:text="عنوان روتین" />

    <!-- First Physical Step Container -->
    <LinearLayout
        android:id="@+id/first_step_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:text="@string/alarm_fullscreen_first_step" />

        <TextView
            android:id="@+id/first_step_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#F1F5F9"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btn_alarm_done"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="@string/alarm_fullscreen_done" />

    <Button
        android:id="@+id/btn_alarm_minimal"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#3B82F6"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="@string/alarm_fullscreen_minimal" />

    <Button
        android:id="@+id/btn_alarm_later"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#334155"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:text="@string/alarm_fullscreen_later" />

</LinearLayout>
