<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="نبض ریتمو 🌿"
        android:textColor="#9AA0AE"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_next_action_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="کار بعدی: بارگذاری..."
        android:textColor="#ECEEF3"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_rhythm_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="امتیاز: --"
            android:textColor="#34D399"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_energy_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="باتری: --"
            android:textColor="#5B8AF5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
