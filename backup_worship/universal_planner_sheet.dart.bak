                              textAlign: TextAlign.center,
                              style: TextStyle(
                                fontFamily: 'Vazirmatn',
                                fontSize: 13.5,
                                fontWeight: FontWeight.bold,
                                color: colors.textPrimary.withValues(alpha: 0.85),
                              ),
